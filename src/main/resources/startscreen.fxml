         <children>
            <Label text="Player 1" />
            <TextField fx:id="player1" promptText="Enter Player 1 name..." />
         </children>
      </VBox>
      <VBox alignment="CENTER" layoutX="185.0" layoutY="312.0" maxWidth="250.0" prefHeight="200.0" prefWidth="100.0" spacing="5.0">
         <children>
            <Label text="Player 2" />
            <TextField fx:id="player2" promptText="Enter Player 2 name..." />
